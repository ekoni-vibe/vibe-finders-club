# Vibe Finders Club environment variables.
# Copy this file to .env and replace placeholders with your own values.

GOOGLE_AI_STUDIO_KEY=your_google_ai_studio_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

RESEND_API_KEY=re_your_key_here
SENDER_EMAIL=you@example.com

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
MAKE_COM_WEBHOOK_SECRET=your_make_com_webhook_secret_here
MAKE_COM_WEBHOOK_URL=https://your_make_com_webhook_url_here

SUPABASE_URL=https://your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

HUD_SEIZED_PROPERTIES_URL=https://your_hud_source_url_here
FANNIE_MAE_REO_URL=https://your_fannie_mae_source_url_here
COUNTY_TAX_DEED_URLS=https://your_county_source_url_here
TAX_DEED_SOURCE_URL=https://your_tax_deed_source_url_here

PORT=3000
BENEFICIARY_NAME=Your Name
BENEFICIARY_COUNTRY=Your Country